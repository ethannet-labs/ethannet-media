{
  "name": "@ethannet/schema",
  "version": "0.0.1",
  "private": true,
  "description": "The photos-api contract: an OpenAPI spec plus TypeScript types generated from it, consumed directly from source (no build step).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:api": "openapi-typescript openapi/photos-api.yaml -o src/generated/photos-api.ts",
    "check:api": "node scripts/check-api.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  }
}
